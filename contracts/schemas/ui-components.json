{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "qualification", "components"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "qualification": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "module",
        "contract",
        "verification",
        "owner_slice",
        "requirements",
        "evidence_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "module": {
          "type": "string",
          "pattern": "^:[a-z0-9]+(:[a-z0-9-]+)+$"
        },
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "owner_slice": {
          "type": "string",
          "pattern": "^BDS-[0-9]{2}\\.[0-9]{2}$"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^BUI-[0-9]{2}$"
          }
        },
        "evidence_required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "implementation",
              "usage_example",
              "applicable_states",
              "accessibility_semantics",
              "behavior_tests",
              "android_ios_evidence"
            ]
          }
        }
      }
    }
  }
}
