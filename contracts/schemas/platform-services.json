{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "services"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "contract",
        "outcomes_and_lifetime",
        "owner_slice",
        "requirements",
        "targets",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^OS[0-9]{2}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "outcomes_and_lifetime": {
          "type": "string",
          "minLength": 1
        },
        "owner_slice": {
          "type": "string",
          "pattern": "^BDS-[0-9]{2}\\.[0-9]{2}$"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^BUI-[0-9]{2}$"
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "android",
              "ios"
            ]
          }
        },
        "verification": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
